# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Node — the image builds its own; copying host-built output would defeat that
node_modules/
frontend/dist/

# Env — `**/` matters: a bare `.env` pattern only matches the build-context
# root, which would let backend/.env be copied into the image and bake the
# database password and OAuth secret into a layer.
**/.env

